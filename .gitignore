# --------------------------------------------------------------- 隐私 / 运行数据
# 这些文件里会出现你真实的联系人名字、聊天记录、模型密钥，一律不进仓库。
config.yaml
wxbridge/config.yaml

# 名单和它的镜像（第一次运行会按 config.yaml 自动生成）
wxbridge/allowlist.json
wxbridge/allowlist.txt
wxbridge/allowlist.json.tmp

# 控制台改过的风格、模型（运行时存档）
wxbridge/style.json
wxbridge/brain.json

# 消息缓存、待补发队列、日志、状态文件
wxbridge/recent.jsonl
wxbridge/pending.jsonl
wxbridge/*.log
wxbridge/*.log.1
wxbridge/supervisor.state
wxbridge/PAUSE
wxbridge/*.pid
wxbridge/wechatauto_logs/

# 发送库自己写的东西（也在用户目录下，这里顺手挡掉本地副本）
.rhythm.json
wechatauto_logs/

